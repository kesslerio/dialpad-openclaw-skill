# Example host overlay for dialpad-team-mcp.service.
# Install as %h/.config/systemd/user/dialpad-team-mcp.service.d/10-host.conf
# then `systemctl --user daemon-reload && systemctl --user restart dialpad-team-mcp`.

[Service]
# Reset the repo-template EnvironmentFile list and load the same credential
# files the live webhook service uses on this host.
EnvironmentFile=
EnvironmentFile=%h/.config/op/work-agent.env
EnvironmentFile=%h/.config/systemd/user/work-secrets.conf
EnvironmentFile=%h/.config/systemd/user/work-runtime.conf
EnvironmentFile=%h/.config/systemd/user/dialpad-runtime.conf
Environment=DIALPAD_SEND_GATE_CONFIG=%h/.config/systemd/user/dialpad-send-gate.json
Environment=DIALPAD_TEAM_MCP_CONFIG=%h/.config/dialpad/team-mcp.json
Environment=DIALPAD_SEND_API_TOKENS=%h/.config/dialpad/send-api-tokens.json
Environment=DIALPAD_COMPANY_ID=<company id>
# Environment=DIALPAD_SMS_DB=/home/art/niemand/logs/sms.db  # default; set if moved
# Interpreter override example for a different python path on this host:
ExecStart=
ExecStart=/usr/bin/python3 %h/projects/skills/work/dialpad/scripts/team_mcp_server.py

# The webhook service also needs the alert config so inbound SMS can be
# forwarded to registered teammates: give dialpad-webhook.service a drop-in
# setting DIALPAD_TEAM_MCP_CONFIG=%h/.config/dialpad/team-mcp.json and
# DIALPAD_SEND_GATE_CONFIG=%h/.config/systemd/user/dialpad-send-gate.json.
